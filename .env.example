# OmniPort Environment Configuration
# Copy this file to .env and fill in your values.
# The server loads .env automatically on startup.

# -------------------------------------------------------------
# Provider — choose ONE block below
# -------------------------------------------------------------

# Option A: Standard OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=sk-proj-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for local/compatible LLMs

# Option B: Azure OpenAI
# AZURE_OPENAI_API_KEY=your_azure_api_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# OPENAI_API_VERSION=2024-02-15-preview

# -------------------------------------------------------------
# Model Tiering
# For Azure: set these to your DEPLOYMENT names.
# For OpenAI: set these to model IDs.
# -------------------------------------------------------------
FAST_MODEL_NAME=gpt-4o-mini
BALANCED_MODEL_NAME=gpt-4o
REASONING_MODEL_NAME=o1-preview

# -------------------------------------------------------------
# Token budget (optional)
# -------------------------------------------------------------
# MAX_TOKENS_BUDGET=200000

# -------------------------------------------------------------
# Server
# -------------------------------------------------------------
# OMNIPORT_PORT=7890

# -------------------------------------------------------------
# Java (needed for build/test validation)
# -------------------------------------------------------------
# JAVA_HOME=/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home
