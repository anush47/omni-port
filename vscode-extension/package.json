{
  "name": "omniport",
  "displayName": "OmniPort — Java Backport Agent",
  "description": "Agentic Java patch backporting powered by LLMs",
  "version": "0.1.0",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "omniport.openPanel",
        "title": "Open Backport Panel",
        "category": "OmniPort"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "omniport-sidebar",
          "title": "OmniPort",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "views": {
      "omniport-sidebar": [
        {
          "type": "webview",
          "id": "omniport.panel",
          "name": "Backport Agent"
        }
      ]
    },
    "configuration": {
      "title": "OmniPort",
      "properties": {
        "omniport.provider": {
          "type": "string",
          "enum": ["openai", "azure"],
          "default": "openai",
          "description": "LLM provider: 'openai' (standard or compatible) or 'azure'"
        },
        "omniport.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key (OPENAI_API_KEY)"
        },
        "omniport.openaiBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional: custom OpenAI-compatible base URL (e.g. for local LLMs)"
        },
        "omniport.azureApiKey": {
          "type": "string",
          "default": "",
          "description": "Azure OpenAI API key (AZURE_OPENAI_API_KEY)"
        },
        "omniport.azureEndpoint": {
          "type": "string",
          "default": "",
          "description": "Azure OpenAI endpoint (e.g. https://my-resource.openai.azure.com/)"
        },
        "omniport.azureApiVersion": {
          "type": "string",
          "default": "2024-02-15-preview",
          "description": "Azure OpenAI API version (OPENAI_API_VERSION)"
        },
        "omniport.fastModel": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Fast-tier model name or Azure deployment name (FAST_MODEL_NAME)"
        },
        "omniport.balancedModel": {
          "type": "string",
          "default": "gpt-4o",
          "description": "Balanced-tier model name or Azure deployment name (BALANCED_MODEL_NAME)"
        },
        "omniport.reasoningModel": {
          "type": "string",
          "default": "o1-preview",
          "description": "Reasoning-tier model name or Azure deployment name (REASONING_MODEL_NAME)"
        },
        "omniport.backendUrl": {
          "type": "string",
          "default": "http://localhost:7890/api/v1",
          "description": "Base URL of the OmniPort backend including API version (e.g. http://localhost:7890/api/v1)"
        },
        "omniport.microservicesUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "Java microservices endpoint URL"
        },
        "omniport.javaHome": {
          "type": "string",
          "default": "",
          "description": "Path to JAVA_HOME (e.g. /Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home)"
        },
        "omniport.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python executable used to start the backend server"
        },
        "omniport.testApply": {
          "type": "boolean",
          "default": true,
          "description": "Enable 'Test Apply' (evaluate mode) by default"
        },
        "omniport.datasetPath": {
          "type": "string",
          "default": "/Users/anush/Projects/university/omni-port/dataset/all_projects_final.csv",
          "description": "Path to the dataset CSV file (relative to workspace or absolute)"
        },
        "omniport.backportCommit": {
          "type": "string",
          "default": "",
          "description": "Optional backport commit SHA"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
